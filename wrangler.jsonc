{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sproutelle-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "eebc9a577cec42c7895c8a736b948f43"
    }
  ]
