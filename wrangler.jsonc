{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sproutelle-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173",
    "PUBLIC_MEDIA_URL": "http://localhost:8787/api/media/file",
    "MEDIA_BUCKET_NAME": "sproutelle-media-dev",
    "NEON_AUTH_BASE_URL": "https://ep-lucky-lake-a1791kzv.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth",
    "NEON_AUTH_JWKS_URL": "https://ep-lucky-lake-a1791kzv.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "sproutelle-media-dev"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "eebc9a577cec42c7895c8a736b948f43"
    }
  ]
}
